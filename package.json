{
  "name": "chandrapal-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "auth:hash": "tsx scripts/auth/hash-password.ts",
    "db:status": "tsx --env-file=.env scripts/db/migrate-content.ts status",
    "db:validate": "tsx --env-file=.env scripts/db/migrate-content.ts validate",
    "db:import": "tsx --env-file=.env scripts/db/migrate-content.ts import",
    "db:compare": "tsx --env-file=.env scripts/db/migrate-content.ts compare",
    "db:verify": "tsx --env-file=.env scripts/db/migrate-content.ts verify",
    "db:idempotency": "tsx --env-file=.env scripts/db/migrate-content.ts idempotency"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
