# Copy this file to .env and fill in a real connection string for local
# development. Never commit real credentials — .env is gitignored.
#
# See README.md ("Database foundation") for setup instructions. Read by
# scripts/db/ always, and by the application only when CONTENT_SOURCE=database
# selects the database-backed repositories (see CONTENT_SOURCE below).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Which content source the application reads through
# (lib/repositories/content-repository.server.ts). Never read directly by
# app/ or components/, and never exposed as NEXT_PUBLIC_*.
#
# Valid values: "typescript" | "database"
#   - typescript: content/projects.ts and content/resume-data.ts (default
#     outside production when this is unset).
#   - database: lib/repositories/*.server.ts, backed by DATABASE_URL above.
#
# In production, this must be set explicitly to one of the two values above —
# an unset or invalid value fails the build/start rather than silently
# defaulting. See README.md ("Content source") for the full fallback policy.
# CONTENT_SOURCE="typescript"

# ---------------------------------------------------------------------------
# Admin authentication (Phase 5). Server-only — never NEXT_PUBLIC_*.
# Required only to use /admin; the public site works without these.
# ---------------------------------------------------------------------------

# The single administrator's login identifier.
ADMIN_EMAIL=""

# scrypt hash of the admin password. Generate with:
#   npm run auth:hash
# NEVER put a plaintext password in this variable — the app rejects anything
# that is not a scrypt hash.
#
# ⚠ ESCAPE EVERY `$` AS `\$`. Next.js expands `$NAME` inside .env values, and a
# scrypt hash is `scrypt$N$r$p$salt$digest` — unescaped, it is silently
# collapsed to a few characters and the admin login then reports that sign-in
# is "not configured". Quoting does NOT prevent this; only the backslashes do.
# `npm run auth:hash` prints the line already escaped — paste it verbatim,
# without adding quotes. See lib/auth/env-file.ts.
#
# Correct:   ADMIN_PASSWORD_HASH=scrypt\$32768\$8\$1\$<salt>\$<digest>
# Broken:    ADMIN_PASSWORD_HASH="scrypt$32768$8$1$<salt>$<digest>"
ADMIN_PASSWORD_HASH=

# HMAC key used to sign session cookies. At least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating this immediately invalidates every existing admin session.
AUTH_SECRET=""
