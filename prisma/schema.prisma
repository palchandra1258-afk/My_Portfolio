// Prisma schema — Phase 7A database foundation.
//
// This schema is a faithful translation of the approved design in
// docs/DATABASE_DESIGN.md into Prisma's schema language. It does not
// introduce any table, column, or constraint that isn't traceable to that
// document (section numbers are cited inline below).
//
// This schema is NOT yet used by the application. lib/repositories/* still
// reads content/projects.ts and content/resume-data.ts exclusively. See the
// "Database foundation" section in README.md for how this is meant to be
// used later.
//
// Requires driver adapters (Prisma 7): the datasource intentionally has no
// inline `url` — the connection string is supplied at runtime via
// @prisma/adapter-pg (see lib/db.ts) and, for CLI operations, via
// prisma7.config.ts. Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Controlled vocabularies (DATABASE_DESIGN.md §7, §26 Open Decision 2)
//
// Mirrors the TypeScript unions in lib/types.ts exactly, including the two
// values VerificationStatus reserves but no project currently uses
// (in_development, planned) — kept per Open Decision 3 for migration safety.
// ---------------------------------------------------------------------------

enum ProjectCategory {
  featured
  supporting
  research
  coming_soon @map("coming-soon")

  @@map("project_category")
}

enum ProjectStatus {
  Completed
  ActiveDevelopment     @map("Active Development")
  InternshipProject     @map("Internship Project")
  ResearchExperimental  @map("Research / Experimental")
  RepositoryPlaceholder @map("Repository Placeholder")
  Unpublished

  @@map("project_status")
}

enum VerificationStatus {
  verified
  partially_verified @map("partially-verified")
  self_reported      @map("self-reported")
  unpublished
  needs_information  @map("needs-information")
  in_development     @map("in-development")
  planned

  @@map("verification_status")
}

enum MetricStatus {
  verified_result    @map("verified-result")
  target
  scope
  dataset_fact       @map("dataset-fact")
  measured
  derived
  assumption
  needs_verification @map("needs-verification")

  @@map("metric_status")
}

enum ImplementationStatus {
  implemented
  experimental
  specified
  in_development @map("in-development")
  planned
  future

  @@map("implementation_status")
}

enum ProjectSource {
  Resume
  GitHub
  Both

  @@map("project_source")
}

// Discriminator for the consolidated ordered-list table (§11).
enum ContentListType {
  results
  what_is_working
  what_is_in_development

  @@map("content_list_type")
}

// Future draft/publish direction (§19) — not exercised by any application
// code yet. Every row migrates as `published` when content migration
// eventually happens, per the plan in §25.
enum PublicationStatus {
  draft
  published
  archived

  @@map("publication_status")
}

// Which authoring path last wrote a project row — CMS_SPECIFICATION.md §63
// (content provenance) and §60 ("the precedence must be explicit").
//
// Added in Phase 7, and it is a safety mechanism, not bookkeeping. Until now
// PostgreSQL was a derived replica: `db:import` rewrote every row from
// content/*.ts, and that was always safe because nothing else ever wrote to
// the database. The moment the CMS can write, an unguarded `db:import` would
// silently destroy every edit made through the admin UI.
//
// So each row records where its current contents came from. `db:import`
// refuses to overwrite a `cms` row unless explicitly told to, and `db:verify`
// excludes `cms` rows from the replica comparison instead of reporting them
// as corruption — they are *supposed* to differ from the TypeScript files.
enum ContentOrigin {
  typescript_import @map("typescript-import")
  cms

  @@map("content_origin")
}

// Preserves the resume-vs-GitHub-verified provenance distinction from
// content/resume-data.ts (§12 "skills").
enum SkillSource {
  resume
  github

  @@map("skill_source")
}

// ---------------------------------------------------------------------------
// Project domain (DATABASE_DESIGN.md §6–11)
// ---------------------------------------------------------------------------

model Project {
  id                Int                @id @default(autoincrement())
  slug              String             @unique
  title             String
  shortDescription  String             @map("short_description")
  problem           String?
  approach          String?
  architecture      String?
  category          ProjectCategory
  status            ProjectStatus
  evidenceStatus    VerificationStatus @map("evidence_status")
  verificationNotes String             @map("verification_notes")
  featured          Boolean            @default(false)
  source            ProjectSource
  githubUrl         String?            @map("github_url")
  demoUrl           String?            @map("demo_url")

  // New field, not present in the TS model — required because CMS_SPECIFICATION.md
  // §23 forbids relying on array/row insertion order (DATABASE_DESIGN.md §6).
  displayOrder Int @map("display_order")

  // Future draft/publish direction (§19, Option A: status lives on the entity).
  // All rows migrate as `published`; nothing currently sets this to draft/archived.
  publicationStatus PublicationStatus @default(published) @map("publication_status")
  publishedAt       DateTime?         @map("published_at")

  // Provenance (§63). Defaults to `typescript_import` so every existing row —
  // all 13, all written by db:import — keeps its current meaning without a
  // data backfill. Only the CMS sets `cms`. See the enum for why this matters.
  contentOrigin ContentOrigin @default(typescript_import) @map("content_origin")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  alternateNames      ProjectAlternateName[]
  metrics             ProjectMetric[]
  implementationNotes ProjectImplementationNote[]
  contentListItems    ProjectContentListItem[]
  technologies        ProjectTechnology[]

  // Self-referential relationships (§10) — deliberately asymmetric: a project
  // can be the source of relationships it declares and, independently, the
  // target of relationships other projects declare about it.
  relationshipsAsSource ProjectRelationship[] @relation("ProjectRelationshipSource")
  relationshipsAsTarget ProjectRelationship[] @relation("ProjectRelationshipTarget")

  @@index([category, displayOrder])
  @@index([featured, displayOrder])
  @@index([status])
  @@index([publicationStatus])
  @@map("projects")
}

// 5 of 13 current projects populate this today, one value each (§6).
model ProjectAlternateName {
  id           Int    @id @default(autoincrement())
  projectId    Int    @map("project_id")
  name         String
  displayOrder Int    @map("display_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_alternate_names")
}

// Directly from the Metric interface (§8). `value` stays text — current
// values include "94.50%", "< 2s", "15.49×", "253,680 records": free-form
// strings with units baked in, not bare numerics.
model ProjectMetric {
  id           Int          @id @default(autoincrement())
  projectId    Int          @map("project_id")
  label        String
  value        String
  kind         MetricStatus
  note         String?
  source       String?
  displayOrder Int          @map("display_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_metrics")
}

// Directly from the ImplementationNote interface (§9). Only cortex-lab
// populates this today (10 rows).
model ProjectImplementationNote {
  id           Int                  @id @default(autoincrement())
  projectId    Int                  @map("project_id")
  label        String
  status       ImplementationStatus
  displayOrder Int                  @map("display_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_implementation_notes")
}

// Self-referential project relationships (§10), resolved to internal IDs —
// this is the one place the database improves on the current TS model,
// where a typo'd relatedTo.slug silently fails to resolve.
//
// CHECK (source_project_id <> related_project_id) IS enforced in the
// database — but it is NOT visible in this file. Prisma 7.10.0 has no
// schema-level CHECK support (verified: `@@check` is rejected by the parser
// with P1012, and no preview feature enables it), so the constraint is
// hand-added at the end of prisma/migrations/20260905021148_init/migration.sql
// as "project_relationships_no_self_reference".
// ⚠ Regenerating that migration from this schema will silently drop it.
model ProjectRelationship {
  id               Int    @id @default(autoincrement())
  sourceProjectId  Int    @map("source_project_id")
  relatedProjectId Int    @map("related_project_id")
  note             String
  displayOrder     Int    @map("display_order")

  sourceProject  Project @relation("ProjectRelationshipSource", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  relatedProject Project @relation("ProjectRelationshipTarget", fields: [relatedProjectId], references: [id], onDelete: Cascade)

  @@unique([sourceProjectId, relatedProjectId])
  @@index([relatedProjectId])
  @@map("project_relationships")
}

// Consolidated, discriminated table for `results` / `whatIsWorking` /
// `whatIsInDevelopment` (§11) — one table, not three, per the recommendation
// in DATABASE_DESIGN.md §11 and Open Decision 4.
model ProjectContentListItem {
  id           Int             @id @default(autoincrement())
  projectId    Int             @map("project_id")
  listType     ContentListType @map("list_type")
  body         String
  displayOrder Int             @map("display_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, listType])
  @@map("project_content_list_items")
}

// Reusable technology lookup (§6) — the one project attribute worth a
// many-to-many, per CMS_SPECIFICATION.md §18 (avoids Python/python/PYTHON
// duplicates across projects).
//
// NOTE (limitation): `name` uniqueness is case-sensitive at the Prisma/DB
// level as written. Case-insensitive enforcement (§26 Open Decision 9)
// requires either a citext-equivalent type or a normalized shadow column —
// deferred; application-layer normalization should compensate until then.
model Technology {
  id   Int    @id @default(autoincrement())
  name String @unique

  projects ProjectTechnology[]

  @@map("technologies")
}

model ProjectTechnology {
  projectId    Int @map("project_id")
  technologyId Int @map("technology_id")
  displayOrder Int @map("display_order")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technologies")
}

// ---------------------------------------------------------------------------
// Profile / resume domain (DATABASE_DESIGN.md §12)
// ---------------------------------------------------------------------------

// Singleton — there is exactly one portfolio owner (§12).
//
// Singleton enforcement IS active in the database, via the hand-added
// "profile_singleton" CHECK (id = 1) at the end of
// prisma/migrations/20260905021148_init/migration.sql (see the note on
// ProjectRelationship above for why it cannot live in this file).
// `id` is deliberately not autoincrementing: the single row is inserted with
// id = 1. The CHECK makes a second row impossible; it does not force a row to
// exist — the import process is what guarantees the row is present.
// ⚠ Regenerating that migration from this schema will silently drop it.
model Profile {
  id          Int      @id
  name        String
  location    String
  phone       String
  email       String
  githubUrl   String   @map("github_url")
  linkedinUrl String   @map("linkedin_url")
  summary     String
  updatedAt   DateTime @updatedAt @map("updated_at")

  education              Education[]
  experience             Experience[]
  achievements           Achievement[]
  skills                 Skill[]
  financeAreas           FinanceArea[]
  technologyFinanceAreas TechnologyFinanceArea[]

  @@map("profile")
}

// `duration` stays free text ("2023 — Present", "2017 — 2023") rather than
// start/end dates — splitting it would require inventing a convention for
// "Present" that the source data doesn't express (§12, §26 Open Decision 8).
model Education {
  id           Int     @id @default(autoincrement())
  profileId    Int     @map("profile_id")
  institution  String
  degree       String
  duration     String
  detail       String?
  displayOrder Int     @map("display_order")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("education")
}

model Experience {
  id           Int    @id @default(autoincrement())
  profileId    Int    @map("profile_id")
  title        String
  organization String
  duration     String
  displayOrder Int    @map("display_order")

  profile    Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  highlights ExperienceHighlight[]

  @@index([profileId])
  @@map("experience")
}

// `experience[].bullets` (§12) — a genuine one-to-many, matching
// CMS_SPECIFICATION.md §27's `highlights` field.
model ExperienceHighlight {
  id           Int    @id @default(autoincrement())
  experienceId Int    @map("experience_id")
  body         String
  displayOrder Int    @map("display_order")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@map("experience_highlights")
}

// `detail` is preserved verbatim, including any inline "[NEEDS INFORMATION]"
// marker text — not split into a structured evidence_status column, since
// Achievement has no such field in the current type (§12).
model Achievement {
  id           Int    @id @default(autoincrement())
  profileId    Int    @map("profile_id")
  title        String
  context      String
  detail       String
  displayOrder Int    @map("display_order")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("achievements")
}

// One table for both `skills` (Record<category, string[]>) and
// `additionalVerifiedSkills` (string[]), distinguished by `source` rather
// than duplicated into a second structurally-identical table (§12).
// `category` is nullable — additionalVerifiedSkills entries have none.
model Skill {
  id           Int         @id @default(autoincrement())
  profileId    Int         @map("profile_id")
  category     String?
  name         String
  source       SkillSource
  displayOrder Int         @map("display_order")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("skills")
}

model FinanceArea {
  id           Int    @id @default(autoincrement())
  profileId    Int    @map("profile_id")
  title        String
  description  String
  displayOrder Int    @map("display_order")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("finance_areas")
}

// Deliberately not projects — matches the source comment in
// content/resume-data.ts ("none of these exist as shipped work").
model TechnologyFinanceArea {
  id           Int    @id @default(autoincrement())
  profileId    Int    @map("profile_id")
  label        String
  displayOrder Int    @map("display_order")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("technology_finance_areas")
}

// ---------------------------------------------------------------------------
// Content revisions (DATABASE_DESIGN.md §20; CMS_SPECIFICATION.md §47-49;
// IMPLEMENTATION_ROADMAP.md Phase 10)
// ---------------------------------------------------------------------------

// Which kind of entity a snapshot belongs to. Only `project` exists today —
// Phase 10 follows Phase 7 (Project CMS), not the profile CMS — but the column
// is a vocabulary rather than a boolean so adding `profile` later is a value,
// not a migration of every existing row.
enum RevisionEntityType {
  project

  @@map("revision_entity_type")
}

// Administrative history. NEVER feeds the public read path (§20: "read by the
// admin, never by app/projects/*"): no public route, metadata function or
// sitemap reads this table.
//
// ── Polymorphic, deliberately ──────────────────────────────────────────────
// `(entity_type, entity_id)` cannot carry a real foreign key — one FK cannot
// point at "whichever table entity_type names" — and DATABASE_DESIGN.md §20
// accepts that trade-off explicitly rather than multiplying one revisions
// table per entity for a feature only `projects` needs now. The cost is real:
// deleting a project does not cascade to its revisions. That is arguably the
// desired behaviour for history, and §53 ("never destroy history silently")
// points the same way, but it does mean orphaned rows are possible.
//
// ── Full snapshot, not a diff ──────────────────────────────────────────────
// §20 again: a diff turns restore into a replay engine, while a snapshot makes
// restore a straight copy. The snapshot holds the whole project including its
// child collections and the admin-only verification notes.
model ContentRevision {
  id            Int                @id @default(autoincrement())
  entityType    RevisionEntityType @map("entity_type")
  entityId      Int                @map("entity_id")
  // Monotonic per (entity_type, entity_id). The unique index below is what
  // enforces it: two concurrent writers computing the same "next" number
  // collide loudly instead of silently producing two version 4s.
  versionNumber Int                @map("version_number")
  snapshot      Json

  // What state the snapshot represents, so history can be read without
  // decoding the blob.
  publicationStatusAtRevision PublicationStatus @map("publication_status_at_revision")

  changeSummary String? @map("change_summary")

  // §20 leaves this as a nullable placeholder for a future `users` table.
  // Until that exists it holds the session subject of the administrator who
  // made the change — real data, not a fabricated author.
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([entityType, entityId, versionNumber])
  @@index([entityType, entityId, createdAt])
  @@map("content_revisions")
}

// ---------------------------------------------------------------------------
// Managed media — Phase 8 (Media & Documents)
// ---------------------------------------------------------------------------

/// Which managed asset a row is. DATABASE_DESIGN.md §5 anticipates a
/// `media_assets` table; §575 says the polymorphic `media_references` join is
/// only warranted "once an actual image field is added to a content model".
/// There are exactly two named assets — the portrait and the resume — so the
/// reference collapses into this controlled vocabulary instead. Adding a third
/// asset is a new member here; a genuine open-ended media library is when
/// `media_references` becomes worth its cost.
enum MediaSlot {
  profile_photo @map("profile-photo")
  resume

  @@map("media_slot")
}

/// One managed asset: its bytes and its metadata, in one row.
///
/// ── Why the bytes live here and not on disk ────────────────────────────────
/// Next snapshots `public/` at build time and serverless filesystems are
/// ephemeral, so a file written there at runtime is not reliably served and
/// may vanish on the next deploy. Writing uploads into the application
/// directory is therefore not production-safe (SECURITY_AND_QUALITY.md §38).
///
/// Keeping the bytes in the same row as the metadata buys three properties
/// that a filesystem plus a database cannot have together:
///
///   - replace and delete are atomic. One transaction commits or rolls back
///     both, so there is no window where the row points at a file that is not
///     there, or a file lingers that nothing points at.
///   - orphaned files are impossible. There is no second system to leak into.
///   - path traversal is impossible. There are no paths.
///
/// The cost is that every byte travels through PostgreSQL and the Node
/// runtime. For two singleton assets of a few megabytes that is a fair trade;
/// for a real media library it would not be, and object storage would be the
/// answer (see README).
model MediaAsset {
  id   Int       @id @default(autoincrement())
  /// One row per slot, enforced by the unique index: "the profile photo" is a
  /// single thing, and two rows claiming to be it is not a representable state.
  slot MediaSlot @unique

  /// The file itself. `Bytes` maps to PostgreSQL `bytea`.
  data Bytes

  /// Sniffed from the file's own magic bytes, never taken from the browser
  /// (SECURITY_AND_QUALITY.md §33: "Never trust the browser-provided MIME
  /// type alone").
  mimeType String @map("mime_type")

  /// A display name shown in the admin and used in Content-Disposition.
  /// Sanitized on the way in; it is never used to build a storage location,
  /// because there is no storage location to build.
  filename String

  /// Bytes. Denormalized from `data` so a listing does not have to read blobs.
  byteSize Int @map("byte_size")

  /// Images only; null for documents. Parsed from the file header.
  width  Int?
  height Int?

  /// CMS_SPECIFICATION.md §36: alt text describes meaningful content and is
  /// never derived from the filename. Null for a document, which has none.
  altText String? @map("alt_text")

  /// §33: optional caption for an image; for the resume this carries the
  /// short description shown beside the download.
  caption String?

  /// The resume's public heading and button label. Null for the photo.
  title         String?
  downloadLabel String? @map("download_label")

  /// Session subject of the administrator who last wrote this row. Same
  /// placeholder-for-a-future-users-table role as ContentRevision.createdBy.
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("media_assets")
}
